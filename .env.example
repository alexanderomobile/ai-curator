# Скопируйте в .env и впишите ключ. Остальное — значения по умолчанию, их можно не задавать.
OPENAI_API_KEY=
# CHAT_MODEL=gpt-4.1-mini
# ROUTER_MODEL=gpt-4.1-mini
# EMBED_MODEL=text-embedding-3-large      # смена модели — пересобрать индекс: python -m curator.ingest
# TEMPERATURE=0.2
# MAX_TOKENS=900
# LLM_TIMEOUT_S=40
# EMBED_TIMEOUT_S=15                     # таймаут запроса эмбеддингов (поиск и индексация), с

# Индекс Chroma. На Windows путь должен быть ASCII (hnswlib не пишет в папку с кириллицей): если путь проекта
# не ASCII, по умолчанию индекс лежит в %LOCALAPPDATA%\ai-curator\index.
# CURATOR_INDEX_DIR=C:\ai-curator-index
# CURATOR_DATA_DIR=data
# CURATOR_JOURNAL=data/journal.db

# LMS: пусто — файлы data/lms/*.json; адрес — HTTP-заглушка (uvicorn curator.lms_stub_api:app --port 8502).
# LMS_URL=http://127.0.0.1:8502

# Поиск: фрагментов в ответе, порог косинусной близости, сколько найти с фильтром, прежде чем его ослабить.
# TOP_K=5
# MIN_SIMILARITY=0.30
# MIN_FILTERED_HITS=2

# Лимиты демо и журнал.
# MAX_QUESTION_CHARS=1500
# RATE_PER_HOUR=20                       # на посетителя (адрес из Cf-Connecting-Ip / X-Forwarded-For)
# Прокси, от которых принимается адрес посетителя (заголовки Cf-Connecting-Ip / X-Forwarded-For) для почасового
# лимита: через запятую, только IP-адреса; заданный список заменяет значение по умолчанию. От любого другого адреса
# заголовки игнорируются и ключом лимита служит адрес соединения. На сервере — адрес cloudflared
# (deploy/ai-curator.paths.env).
# CURATOR_TRUSTED_PROXIES=127.0.0.1,::1
# HOURLY_CAP=60                          # общий потолок в час на всех посетителей
# DAILY_CAP=300
# RETENTION_DAYS=90
# USER_HASH_SALT=                         # соль кода сессии; без неё — случайная на каждый запуск
# SHOW_LIVE_TEXTS=0                       # 1 — показывать на дашборде тексты вопросов живых посетителей
# CURATOR_SOURCE=live                     # live | eval | demo — метка записей журнала по умолчанию

# «Текущее время» для демо и скриншотов (без зоны — МСК): дни до дедлайна считаются от него. На 12:00 посчитаны
# примеры в docs/. Не задано — настоящее время (так работает публичное демо).
# CURATOR_NOW=2026-11-12T12:00
