# Пути и адреса службы ИИ-куратора — не секреты (ключ OpenAI и соль — в /etc/ai-curator.env).
# deploy.sh кладёт этот файл в /etc/ai-curator.paths.env; его подключают все юниты (EnvironmentFile=).
# Команды вручную на сервере берут те же пути, иначе отчёт искал бы журнал не там (отчёт открывает журнал только
# для чтения и без файла падает с ошибкой):
#   cd /opt/ai-curator && set -a && . /etc/ai-curator.paths.env && set +a
#   .venv/bin/python -m curator.report --days 7
# Индекс лежит в изменяемой папке: Chroma открывает свою SQLite-базу на запись даже для поиска.
CURATOR_INDEX_DIR=/var/lib/ai-curator/index
CURATOR_JOURNAL=/var/lib/ai-curator/journal.db
CURATOR_EXPORTS_DIR=/var/lib/ai-curator/exports
# Куратор берёт данные LMS по HTTP из заглушки — как из настоящей LMS. Заглушка слушает только 127.0.0.1.
LMS_URL=http://127.0.0.1:8502
# Прокси, от которых куратор принимает адрес посетителя в заголовках Cf-Connecting-Ip / X-Forwarded-For (ключ
# почасового лимита); от остальных адресов заголовки игнорируются. Через запятую, только IP-адреса.
# 192.168.95.103 — LXC 101 с cloudflared: правило туннеля curator.optimum-ltd.com -> http://192.168.95.173:8501
# (/etc/cloudflared/config.yml в LXC 101), к Streamlit cloudflared подключается по LAN с этого адреса.
# Переедет cloudflared — поправить здесь, иначе все посетители делят один лимит на адрес прокси.
CURATOR_TRUSTED_PROXIES=192.168.95.103
